# Venue contact settings for lost-item reports.
# Start with a local .env copy; provide your own passwords and provider credentials there.
# Configure sending with docs/email-setup.md, or start in development with MAIL_MODE=log for local email previews.

APP_URL=http://localhost:3000 # Public origin of the lost-item form; this is also the permitted submission origin.
HOST=127.0.0.1 # Local binding by default. Change this if your deployment requires another interface.
PORT=3000 # Listening port for the production server; development uses the framework config.
DB_PATH=.data/app.sqlite # Item descriptions, contact details, and venue notification records; SQLite file relative to the app directory. Preserve it across deployments.
ADMIN_PASSWORD= # Protect the operator who can read lost-item reports: username admin, random password of 16 or more characters.
OWNER_EMAIL=owner@example.com # Venue inbox for lost-item reports; use an address monitored by the team handling them.
REVIEWER_EMAIL=reviewer@example.com # Unused here. The lost-item reports workflow does not look up REVIEWER_EMAIL.
MAIL_MODE=sandbox # Keep lost-item reports in sandbox while setting up; production sends email; log works locally in development.
MAIL_FROM=sender@example.com # Sender identity for lost-item reports; the domain must be verified in Mailtrap for production.
MAILTRAP_PRODUCTION_TOKEN= # Required for real lost-item reports: your Mailtrap transactional sending token. Not needed in sandbox.
MAILTRAP_SANDBOX_TOKEN= # API token with access to the Sandbox used for lost item report messages.
MAILTRAP_INBOX_ID= # Numeric Sandbox ID from its API integration settings; captured lost email stays here.
